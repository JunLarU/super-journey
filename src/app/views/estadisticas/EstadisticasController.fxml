<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.controllers.estadisticas.EstadisticasController"
            prefWidth="1200"
            prefHeight="800"
            styleClass="stats-root"
            stylesheets="@../../../assets/css/estadisticas.css">

    <top>
        <VBox spacing="10" styleClass="stats-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Panel de estadísticas"
                           styleClass="stats-page-title"/>
                    <Label text="Ventas, desempeño, tendencias y comportamiento operativo de CAFI."
                           styleClass="stats-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="lblPeriodoActual"
                           text="Hoy"
                           styleClass="stats-period"/>
                    <Label fx:id="lblFechaActual"
                           text="Sin actualizar"
                           styleClass="stats-updated"/>
                </VBox>

                <Button text="Actualizar"
                        onAction="#onRecargarClicked"
                        styleClass="stats-primary-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="8" style="-fx-padding: 0 16 16 16;">

            <TabPane fx:id="tabPane"
                     tabClosingPolicy="UNAVAILABLE"
                     VBox.vgrow="ALWAYS"
                     styleClass="stats-tabs">

                <Tab fx:id="tabHoy" text="Hoy">
                    <ScrollPane fitToWidth="true"
                                pannable="true"
                                styleClass="stats-scroll">
                        <content>
                            <VBox fx:id="hoyContent"
                                  spacing="16"
                                  style="-fx-padding: 16;"/>
                        </content>
                    </ScrollPane>
                </Tab>

                <Tab fx:id="tabSemana" text="7 días">
                    <ScrollPane fitToWidth="true"
                                pannable="true"
                                styleClass="stats-scroll">
                        <content>
                            <VBox fx:id="semanaContent"
                                  spacing="16"
                                  style="-fx-padding: 16;"/>
                        </content>
                    </ScrollPane>
                </Tab>

                <Tab fx:id="tabMes" text="Mes actual">
                    <ScrollPane fitToWidth="true"
                                pannable="true"
                                styleClass="stats-scroll">
                        <content>
                            <VBox fx:id="mesContent"
                                  spacing="16"
                                  style="-fx-padding: 16;"/>
                        </content>
                    </ScrollPane>
                </Tab>

                <Tab fx:id="tabSeisMeses" text="6 meses">
                    <ScrollPane fitToWidth="true"
                                pannable="true"
                                styleClass="stats-scroll">
                        <content>
                            <VBox fx:id="seisMesesContent"
                                  spacing="16"
                                  style="-fx-padding: 16;"/>
                        </content>
                    </ScrollPane>
                </Tab>
            </TabPane>

            <VBox fx:id="contentBox"
                  alignment="CENTER"
                  spacing="8"
                  visible="false"
                  managed="false"
                  styleClass="stats-loading">
                <ProgressIndicator fx:id="progressIndicator"
                                   progress="-1.0"/>
                <Label text="Calculando estadísticas..."
                       styleClass="stats-subtitle"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
