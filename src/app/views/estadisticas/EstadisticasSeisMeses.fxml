<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.controllers.estadisticas.EstadisticasSeisMesesController">

    <!-- ===================== TARJETAS ===================== -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints percentWidth="16"/>
            <ColumnConstraints percentWidth="16"/>
            <ColumnConstraints percentWidth="16"/>
            <ColumnConstraints percentWidth="16"/>
            <ColumnConstraints percentWidth="16"/>
            <ColumnConstraints percentWidth="16"/>
        </columnConstraints>

        <!-- USUARIOS -->
        <VBox GridPane.columnIndex="0" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);
                     -fx-border-color: #3498DB; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;">
            <Label text="👥 Usuarios" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label fx:id="lblTotalUsuariosSeisMeses" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3498DB; -fx-padding: 5 0 0 0;"/>
            <Label text="Últimos 6 meses" 
                   style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-padding: 5 0 0 0;"/>
        </VBox>

        <!-- PRODUCTOS -->
        <VBox GridPane.columnIndex="1" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);
                     -fx-border-color: #2ECC71; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;">
            <Label text="🍔 Productos" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label fx:id="lblTotalProductosSeisMeses" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2ECC71; -fx-padding: 5 0 0 0;"/>
            <Label text="Últimos 6 meses" 
                   style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-padding: 5 0 0 0;"/>
        </VBox>

        <!-- AVISOS -->
        <VBox GridPane.columnIndex="2" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);
                     -fx-border-color: #E74C3C; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;">
            <Label text="📢 Avisos" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label fx:id="lblTotalAvisosSeisMeses" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #E74C3C; -fx-padding: 5 0 0 0;"/>
            <Label text="Últimos 6 meses" 
                   style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-padding: 5 0 0 0;"/>
        </VBox>

        <!-- MENUS -->
        <VBox GridPane.columnIndex="3" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);
                     -fx-border-color: #9B59B6; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;">
            <Label text="📅 Menús" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label fx:id="lblTotalMenusSeisMeses" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #9B59B6; -fx-padding: 5 0 0 0;"/>
            <Label text="Últimos 6 meses" 
                   style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-padding: 5 0 0 0;"/>
        </VBox>

        <!-- CATEGORÍAS -->
        <VBox GridPane.columnIndex="4" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);
                     -fx-border-color: #F39C12; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;">
            <Label text="🏷 Categorías" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label fx:id="lblTotalCategoriasSeisMeses" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #F39C12; -fx-padding: 5 0 0 0;"/>
            <Label text="Total" 
                   style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-padding: 5 0 0 0;"/>
        </VBox>

        <!-- INGREDIENTES -->
        <VBox GridPane.columnIndex="5" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);
                     -fx-border-color: #1ABC9C; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;">
            <Label text="🥬 Ingredientes" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label fx:id="lblTotalIngredientesSeisMeses" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1ABC9C; -fx-padding: 5 0 0 0;"/>
            <Label text="Total" 
                   style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </GridPane>

    <!-- ===================== FILA 1 ===================== -->
    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- Usuarios por Tipo -->
        <VBox GridPane.columnIndex="0" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <Label text="Usuarios por Tipo (Últimos 6 meses)" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 0 0 15 0;"/>
            <PieChart fx:id="chartUsuariosTipoSeisMeses"
                      VBox.vgrow="ALWAYS" 
                      minHeight="300"/>
        </VBox>

        <!-- Productos por categoría -->
        <VBox GridPane.columnIndex="1" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <Label text="Top Categorías de Productos (Últimos 6 meses)" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 0 0 15 0;"/>
            <BarChart fx:id="chartProductosCategoriaSeisMeses"
                      VBox.vgrow="ALWAYS"
                      minHeight="300">
                <xAxis>
                    <CategoryAxis label="Categoría"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Cantidad"/>
                </yAxis>
            </BarChart>
        </VBox>
    </GridPane>

    <!-- ===================== FILA 2 ===================== -->
    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="33"/>
            <ColumnConstraints percentWidth="34"/>
            <ColumnConstraints percentWidth="33"/>
        </columnConstraints>

        <!-- Avisos por Establecimiento -->
        <VBox GridPane.columnIndex="0" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <Label text="Avisos por Establecimiento (Últimos 6 meses)" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 0 0 15 0;"/>
            <PieChart fx:id="chartAvisosEstablecimientoSeisMeses"
                      VBox.vgrow="ALWAYS"
                      minHeight="250"/>
        </VBox>

        <!-- Menús por Día -->
        <VBox GridPane.columnIndex="1" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <Label text="Menús por Día (Últimos 6 meses)" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 0 0 15 0;"/>
            <BarChart fx:id="chartMenusDiaSeisMeses"
                      VBox.vgrow="ALWAYS"
                      minHeight="250">
                <xAxis>
                    <CategoryAxis label="Día"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Cantidad"/>
                </yAxis>
            </BarChart>
        </VBox>

        <!-- Productos por Estado -->
        <VBox GridPane.columnIndex="2" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <Label text="Productos por Estado (Últimos 6 meses)" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 0 0 15 0;"/>
            <PieChart fx:id="chartProductosEstadoSeisMeses"
                      VBox.vgrow="ALWAYS"
                      minHeight="250"/>
        </VBox>
    </GridPane>

</VBox>